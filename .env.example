# Copiá este archivo a .env (gitignored) y completá el valor.
#
# CAELESTIA_CALENDAR_URL: URL secreta iCal de tu Google Calendar.
#   Google Calendar (web) → Configuración → tu calendario
#   → "Integrar calendario" → "Dirección secreta en formato iCal"
#   (es un secreto: da acceso de lectura a tu calendario)
#
# Setup del helper de agenda (una vez, el venv no se versiona):
#   python3 -m venv ~/.local/state/caelestia/calendar-venv
#   ~/.local/state/caelestia/calendar-venv/bin/pip install recurring-ical-events icalendar

CAELESTIA_CALENDAR_URL=
